							{
								key = 
								{
									m_id = 875249163
								}
								value = 
								{
									_class = "CCommentAnimNode"
									m_sName = "This manager takes care of keeping certain bones in the \'gun is empty\' position"
									m_vecPosition = [ -320.0, -384.0 ]
									m_nNodeID = 
									{
										m_id = 875249163
									}
									m_sNote = ""
									m_commentText = "b_empty overrides relevant parts (e.g. slide, bolt catcher...), but a Tag can override that override (!) back to the passthrough behaviour, letting the reload animation animate these parts back to the normal state.\n\nThe relevant parts are kept in a *local* weightlist: Only_GunIsEmpty. (It\'s local to the VMDL and not in the weightlist prefab since different guns have different parts staying back.)\n\nThis way, there\'s no need to create a variant of most animations with these parts in that specific position (or being animated to go back & staying back): this takes care of everything in one place. When reloading while empty, you can toggle off b_empty at any time, preferably when you increment the ammo counter.\n"
									m_size = [ 640.0, 352.0 ]
									m_color = [ 47, 79, 79, 255 ]
								}
							},
