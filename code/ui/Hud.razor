@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Globalization;
@using System.Linq;
@inherits PanelComponent
@namespace Sandbox


<root>
    <div class="hud">
        <div class="hurt-border @(playerHealth < playerMaxHealth ? "" : "hidden")"
            style="
            background:
                radial-gradient( rgba(255,0,0,0) @((playerHealth / playerMaxHealth) * 100)%, rgba(255,0,0,1) 70%)
            ">
        </div>
        <div class="look-interactable @(LookingAtInteractable ? "" : "hidden")">
            <p>@(string.IsNullOrWhiteSpace(InteractionPromptText) ? "Press" : InteractionPromptText)</p>
            <img class="use-glyph" src="@useKeyPath">
            <p class="interaction-cost @(string.IsNullOrWhiteSpace(InteractionCostText) ? "hidden" : "")">@InteractionCostText</p>
        </div>
        <div class="look-interactable-revive @(LookingAtInteractableRevive ? "" : "hidden")">
            <p>@(string.IsNullOrWhiteSpace(InteractionPromptText) ? "Hold" : InteractionPromptText)</p>
            <div class="hold-glyph-wrapper" style="background: conic-gradient(black @(HoldProgress * 100)%, black 100%);">
                <img class="hold-use-glyph" src="@useKeyPath">
            </div>
            <p class="interaction-cost @(string.IsNullOrWhiteSpace(InteractionCostText) ? "hidden" : "")">@InteractionCostText</p>
        </div>
        <div class="look-interactable-hold @(LookingAtInteractableHold ? "" : "hidden")">
            <p>@(string.IsNullOrWhiteSpace(InteractionPromptText) ? "Hold" : InteractionPromptText)</p>

            <div class="hold-glyph-wrapper">
                
                <div class="hold-fill" style="height:@(HoldProgress * 100)%"></div>

                <img class="hold-use-glyph" src="@useKeyPath">
            </div>
            <p class="interaction-cost @(string.IsNullOrWhiteSpace(InteractionCostText) ? "hidden" : "")">@InteractionCostText</p>
        </div>
        <div class="player-card-container">


            @if (PlayerList is not null)
            {
                foreach (var playa in PlayerList)
                {
                    var displayPoints = playa.player != null ? playa.player.Points : playa.Points;
                    if(playa.PlayerSteamID == Connection.Local.SteamId.ToString())
                    {
                        <PlayerCard @ref="localPlayerCard" PlayerName="@playa.PlayerName" Points="@displayPoints" PlayerSteamId="@playa.PlayerSteamID" IsLocalPlayer="@(Connection.Local.SteamId.ToString() == playa.PlayerSteamID)"/>
                         if (changeAmount > 0)
                         {
                           AddPointPanel();

                         }
                    
                    }
                    if (playa.PlayerSteamID != Connection.Local.SteamId.ToString())
                    {
                        <PlayerCard PlayerName="@playa.PlayerName" Points="@displayPoints" PlayerSteamId="@playa.PlayerSteamID" IsLocalPlayer="@(Connection.Local.SteamId.ToString() == playa.PlayerSteamID)"/>
                    }
                }
            }
        </div>
        <div class="rounds-dissolve-wrap">
            <div class="rounds-container">
                <p class="rounds">@Round</p>
            </div>
        </div>

        <div class="crosshair-contain @(!player.isAiming ? "" : "hidden")">
            <Crosshair isWalking="@player.isWalking" isAiming="@player.isAiming" isShooting="@player.isFiring" isSprinting="@player.isSprinting" />
        </div>

        <div class="weapon-contain">
            @if (player is not null
              && player.Inventory is not null
              && player.CurrentWeaponClass is not null
              && player.Inventory.WeaponsAmmo is not null
              && player.CurrentWeaponSlot >= 0
              && player.CurrentWeaponSlot < player.Inventory.WeaponsAmmo.Count)
            {
                <EquippedWeapon AmmoClip="@player.Inventory.WeaponsAmmo[player.CurrentWeaponSlot].CurrentMag" AmmoTotal="@player.Inventory.WeaponsAmmo[player.CurrentWeaponSlot].AmmoTotal" WeaponName="@(player.Inventory.Weapons[player.CurrentWeaponSlot].Packed > 0 ? player.CurrentWeaponClass.PackedName : player.CurrentWeaponClass.WeaponName)", color="@(player.Inventory.Weapons[player.CurrentWeaponSlot].Packed == 1 ? "green" : player.Inventory.Weapons[player.CurrentWeaponSlot].Packed == 2 ? "blue" : player.Inventory.Weapons[player.CurrentWeaponSlot].Packed == 3 ? "purple" : player.Inventory.Weapons[player.CurrentWeaponSlot].Packed == 4 ? "gold" : "whitesmoke")" />
            }

        </div>
        <div class="perk-icon-container">
            @if(PerkIcons is not null)
            {
                @foreach(var perkIcon in PerkIcons)
                {
                    //Log.Info("perkicon: " + perkIcon);
                    <PerkIcon PerkIconImage="@perkIcon" />
                }
            }
        </div>
        <div class="powerup-container" @ref="PowerupContaina">
        
        </div>
    </div>
</root>

@code
{
    Texture useKey;


    //string ReviveText = $"Hold " + <color=#ffcc00>Input.GetButtonOrigin("use")</color> + " to revive";

    int Round { get; set; }

    //bool isAiming { get; set; } = false;

    [Property]
    public Player player => GameObject.GetComponent<Player>();

    // [Change("hackyasfuck")]
    // public List<Connection> idek => Connection.All.ToList();

    Panel PowerupContaina { get; set; }


    PowerupIcon FiresaleIcon { get; set; }

    PowerupIcon DoublepointsIcon { get; set; }

    PowerupIcon InstakillIcon { get; set; }

    PlayerCard localPlayerCard;

    float HoldProgress { get; set; } = 0f;

    //List<Player> PlayerList { get; set; }

    bool isAiming => player?.isAiming ?? false;


    List<PlayerListInfo> PlayerList => GameModeManager?.PlayersList ?? new();

    float changeAmount { get; set; }

    float playerHealth => player?.Health ?? 0f;

    float playerMaxHealth => player?.MaxHealth ?? 1f;

    List<string> PerkIcons => player?.PerkIcons ?? new();

    bool APowerUpActivated { get; set; } = false;

    int AmountOfPowerUpsActivated { get; set; } = 0;

    bool LookingAtInteractable => player?.LookingAtInteractable ?? false;
    bool LookingAtInteractableRevive => player?.LookingAtInteractableRevive ?? false;
    bool LookingAtInteractableHold => player?.LookingAtInteractableHold ?? false;
    string InteractionPromptText => player?.InteractionPromptText ?? string.Empty;
    string InteractionCostText => player?.InteractionCostText ?? string.Empty;

    bool IsUsingVoiceChat => player?.IsUsingVoiceChat ?? false;

    [Property]
    TextChatComp textChatComp { get; set; }


    int currentMag => player.Inventory.WeaponsAmmo[player.CurrentWeaponSlot].CurrentMag;

    float healthratio;

    GameModeManager GameModeManager;



    /// <summary>
    /// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
    /// </summary>
    protected override int BuildHash()
    {
        var hash = new HashCode();


        hash.Add(Round);

        hash.Add(player);
        hash.Add(isAiming);
        hash.Add(GameModeManager?.PlayersList);
        hash.Add(player?.isFiring);
        hash.Add(player?.isWalking);
        hash.Add(player?.isSprinting);
        hash.Add(player?.AmmoInMag);
        hash.Add(player?.AmmoTotal);
        hash.Add(player?.WeaponName);
        hash.Add(player?.Health);
        hash.Add(player?.MaxHealth);
        hash.Add(player?.LookingAtInteractable);
        hash.Add(player?.LookingAtInteractableRevive);
        hash.Add(player?.LookingAtInteractableHold);
        hash.Add(player?.InteractionPromptText);
        hash.Add(player?.InteractionCostText);
        hash.Add(player?.PerkIcons);
        hash.Add(HoldProgress);
        hash.Add(player?.IsUsingVoiceChat);
        hash.Add(textChatComp);

        hash.Add(player.CurrentWeaponClass);
        hash.Add(PowerupContaina);
        hash.Add(FiresaleIcon);
        hash.Add(InstakillIcon);
        hash.Add(DoublepointsIcon);

        return hash.ToHashCode();
    }

    protected override void OnStart()
    {
        if (player is null)
        {
            return;
        }


        player.PlayerPointsChanged += HandlePlayerPointsChanged;
        Player.AnyPlayerPointsChanged += HandleAnyPlayerPointsChanged;
        player.PerkListChanged += HandlePerkListChange;




        GameModeManager = Scene.GetAllComponents<GameModeManager>().FirstOrDefault();
        Round = GameModeManager?.Round ?? 0;
        if (GameModeManager is not null)
        {
            GameModeManager.PlayerListChange += PlayerListChanged;
            GameModeManager.ChangeRound += RoundChanged;
            GameModeManager.PowerUpActivated += PowerUpActivated;
            GameModeManager.PowerUpDeactivated += PowerUpDeactivated;
        }

        //Log.Info(GameModeManager.PlayerList.Count);

    }


    private void PowerUpActivated(string powerup)
    {

        switch (powerup)
        {
            case "firesale":

                FiresaleIcon = PowerupContaina.AddChild<PowerupIcon>();

                FiresaleIcon.PowerUpPath = "ui/firesalecropped.png";

                break;
            case "instakill":

                InstakillIcon = PowerupContaina.AddChild<PowerupIcon>();
                InstakillIcon.PowerUpPath = "ui/instakillcropped.png";

                break;
            case "doublepoints":

                DoublepointsIcon = PowerupContaina.AddChild<PowerupIcon>();

                DoublepointsIcon.PowerUpPath = "ui/x2cropped.png";

                break;
        }

    }

    private void PowerUpDeactivated(string powerup)
    {
        switch (powerup)
        {
            case "firesale":

                FiresaleIcon.Delete();
                
                break;
            case "instakill":

                InstakillIcon.Delete();

                break;
            case "doublepoints":

                DoublepointsIcon.Delete();

                break;
        }
    }




    protected override void OnDestroy()
    {
        if (player is not null)
        {
            player.PlayerPointsChanged -= HandlePlayerPointsChanged;
            player.PerkListChanged -= HandlePerkListChange;
        }

        Player.AnyPlayerPointsChanged -= HandleAnyPlayerPointsChanged;


        if (GameModeManager is not null)
        {
            GameModeManager.PlayerListChange -= PlayerListChanged;
            GameModeManager.ChangeRound -= RoundChanged;
            GameModeManager.PowerUpActivated -= PowerUpActivated;
            GameModeManager.PowerUpDeactivated -= PowerUpDeactivated;
        }

        base.OnDestroy();
    }


    public void AddPointPanel()
    {

        if (changeAmount == 0) return;
        var popup = new GainPoints();
        if (popup == null) return;
        popup.PointValue = changeAmount;
        popup.AddClass("points-popup");
        if(localPlayerCard != null)
        {
            localPlayerCard.AddChild(popup);
        }
        //this.Panel.AddChild(popup);
        changeAmount = 0;
    }

    protected override void OnUpdate()
    {
        base.OnUpdate();

        if (player is null)
        {
            return;
        }



        useKey = Input.GetGlyph("use", InputGlyphSize.Small, true);
        if (player.LookingAtInteractableRevive)
        {
            HoldProgress = Math.Clamp(player.TimeSinceInteractHeld / player.CurrentInterHoldTime, 0f, 1f);
        }

        if (player.LookingAtInteractableHold)
        {
            HoldProgress = Math.Clamp(player.TimeSinceInteractHeld / player.CurrentInterHoldTime, 0f, 1f);
        }


        //Log.Info(useKey);

        // Update power-up timers directly from GameModeManager
        if (GameModeManager is not null)
        {
            if (InstakillIcon is not null && GameModeManager.InstaKillTimeLeft >= 0)
                InstakillIcon.TimeLeft = Math.Ceiling(GameModeManager.InstaKillTimeLeft).ToString("0");
            if (DoublepointsIcon is not null && GameModeManager.DoublePointsTimeLeft >= 0)
                DoublepointsIcon.TimeLeft = Math.Ceiling(GameModeManager.DoublePointsTimeLeft).ToString("0");
            if (FiresaleIcon is not null && GameModeManager.FireSaleTimeLeft >= 0)
                FiresaleIcon.TimeLeft = Math.Ceiling(GameModeManager.FireSaleTimeLeft).ToString("0");
        }
    }



    private void PlayerListChanged()
    {
        //PlayerList = GameModeManager.PlayersList;   
        StateHasChanged();
    }

    private void RoundChanged()
    {
        if (GameModeManager is not null)
        {
            Round = GameModeManager.Round;
        }
    }

    private void HandlePlayerPointsChanged(float amountChanged)
    {
        changeAmount = amountChanged;
        //Log.Info("changed amount: " + changeAmount);
        StateHasChanged();

    }

    private void HandlePerkListChange()
    {
        
        StateHasChanged();
    }

    private void HandleAnyPlayerPointsChanged()
    {
        
        StateHasChanged();

    }



    string useKeyPath => useKey?.ResourcePath ?? string.Empty;
}
