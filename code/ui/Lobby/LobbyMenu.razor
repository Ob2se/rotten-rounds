    private void MapBrowseClick()
    {
        if (!Networking.IsHost) return;
        TheMapSelector.Enabled = true;
        TheMapSelector.MapList = LobbyCreator.MapList;
        this.Enabled = false;
        foreach (var x in Scene.GetAllComponents<WorldPanel>())
        {
            x.Enabled = false;    
        }
    }

    private void OptionsClick()
