@using Sandbox;
@using Sandbox.UI;
@using System.Threading.Tasks;
@inherits MainMenuPanelComponent
@namespace Sandbox

<div class="fullscreen-blur"></div>
<div class="create-lobby-container @(IsMenuVisible ? "" : "hidden")">
    <div class="left-side-container">
        
        <ChosenMap @key="@SelectedMap" @ref="@TheChosenMaper" class="chosen-container" @MapAuthor="@SelectedMap.Author" @MapDescription="@SelectedMap.Description" @MapTitle="@SelectedMap.Name.ToUpper()" @MapDownVotes="@SelectedMap.DownVotes.ToString()" @MapUpVotes="@SelectedMap.UpVotes.ToString()" @MapThumbnail="@SelectedMap.Thumbnail"></ChosenMap>
        <div class="buttons-wrapper">
            <button class="button-start @(isHost && SelectedMap != null ? "" : "disabled")" @onclick="@OnStartClick">Start Game</button>
            <button class="button-browse @(isHost ? "" : "disabled")" @onclick="@MapBrowseClick">Map Browse</button>
            <button class="button-game-options @(isHost ? "" : "disabled")" @onclick="@GameOptionsClick">Customize Game</button>
            <button class="button" @onclick="@OptionsClick">Options</button>
            <button class="button" @onclick="@LeaveClick">Leave</button>
        </div>
    </div>
    @* <div class="right-side-container">
        <PlayerList Connections="@Connections"></PlayerList>
    </div> *@
</div>


@code
{

    [Property]
    public MapSelector TheMapSelector { get; set; }

