    private void OnStartClick()
    {
        if (!Networking.IsHost) return;
        LobbyCreator.ChooseMap(SelectedMap);
        Log.Info(isHost);
    }

    private async Task GetLobbyCreator()
    {
        await Task.DelayRealtimeSeconds(.1f);
        LobbyCreator = Scene.GetAllComponents<CreateLobby>().First();
    }


    private void GameOptionsClick()
    {
