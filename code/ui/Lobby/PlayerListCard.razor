@using Sandbox;
@using Sandbox.UI;
@inherits MainMenuPanel
@namespace Sandbox

<div class="card-rut">
    <div class="playerlist-card-container">
        <img class="playerlist-card-title" src="@PlayerTitlePath" />
        <div class="name-level-wrapper">
            <div class="playerlist-card-name">@PlayerName</div>
        </div>
    </div>
    <div class="player-level">
        <div class="playerlist-card-level">@PlayerLevel</div>
    </div>
</div>

@code
{

	[Parameter]
    public string PlayerName { get; set; }

    [Parameter]
    public int PlayerLevel { get; set; }

    [Parameter]
    public string PlayerTitlePath { get; set; }

	/// <summary>
	/// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
	/// </summary>
	protected override int BuildHash() => System.HashCode.Combine( PlayerName, PlayerLevel, PlayerTitlePath );
}
