@using Sandbox;
@using Sandbox.UI;
@inherits MainMenuPanelComponent
@namespace Sandbox


<div class="menu @(IsMenuVisible ? "" : "hidden")">
    <div class="title"></div>

    <div class="buttons-container">
        <button class="button-play" @onclick="@OnPlayClicked" @onmouseover="@OnPlayHovered" @onmouseout="@OnPlayUnHovered"></button>
        @* <button class="button-leaderboards" @onclick="@OnLeaderboardClicked" @onmouseover="@OnLeaderboardHovered" @onmouseout="@OnLeaderboardUnHovered"></button>
        <button class="button-customize" @onclick="@OnCustomizeClicked" @onmouseover="@OnCustomizeHovered" @onmouseout="@OnCustomizeUnHovered"></button> *@
        <div class="esc-hint@(IsEscVisible ? "" : "hidden")">[ESC] Menu</div>
    </div>

    <div class="motd">
        @*@<Motd @ref="MotdPanel" ImagePath="@NewsImagePath" Title="@NewsTitle" ShortDescription="@NewsShortDescription" />*@
    </div>
</div>
<div class="back-button-container @(IsBackVisible ? "" : "hidden")">
    <button class="back-button" @onclick="@OnBackClicked">Back</button>
</div>


@code
{
    public bool IsBackVisible = false;
    public bool IsEscVisible = true;


    public string GameTitle = "Rotten Rounds";


    [Property]
    private DecalHighlight CreateDecal { get; set; }


    [Property]
    private DecalHighlight JoinDecal { get; set; }


    [Property]
    LightFlickerSolid LightCreate { get; set; }

    [Property]
    LightFlickerSolid LightJoin { get; set; }

    [Property]
    List<GameObject> ObjectsForPlay { get; set; }

    [Property]
    List<GameObject> ObjectsForLeaderboards { get; set; }

    [Property]
    List<GameObject> ObjectsForCustomize { get; set; }

    [Property]
    public CreateLobby LobbyCreator { get; set; }

    [Property]
    public DoorSwiv DoorSwiver { get; set; }

    [Property]
    LightFlickerPlaySign PlaySign { get; set; }

    PlayMenu PlayPanel;
    //Panel CustomizePanel;
    //Panel LeaderboardsPanel;
    Panel OptionsPanel;
    //MainMenu MainMenuPanel { get; set; }
    Motd MotdPanel;


    MainMenuPanel CurrentPanel;


    List<MainMenuPanel> currentFocusedMenu = new();

    [Property]
    CameraPanner CameraPan { get; set; }


    /// <summary>
    /// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
    /// </summary>
    protected override int BuildHash() => System.HashCode.Combine(IsMenuVisible, CurrentPanel);


    protected override void OnStart()
    {



        IsMenuVisible = true;

        PlayPanel = Panel.AddChild<PlayMenu>();
        PlayPanel.CreaterDecal = CreateDecal;
        PlayPanel.JoinerDecal = JoinDecal;
        PlayPanel.JoinLight = LightJoin;
        PlayPanel.CreateLight = LightCreate;
        //PlayPanel.IsMenuVisible = false;


    }


    public void OnPlayHovered()
    {
        PlaySign.isHovered = true;
        DoorSwiver.isHovered = true;
        foreach (var x in ObjectsForPlay)
        {
            x.AddComponent<HighlightOutline>();    
        }

    }

    public void OnLeaderboardHovered()
    {
        foreach (var x in ObjectsForLeaderboards)
        {
            x.AddComponent<HighlightOutline>();
        }
    }

    public void OnCustomizeHovered()
    {
        foreach (var x in ObjectsForCustomize)
        {
            x.AddComponent<HighlightOutline>();
        }
    }

    public void OnPlayUnHovered()
    {
        PlaySign.isHovered = false;
        DoorSwiver.isHovered = false;
        foreach (var x in ObjectsForPlay)
        {
            x.GetComponent<HighlightOutline>()?.Destroy();
        }

    }

    public void OnLeaderboardUnHovered()
    {
        foreach (var x in ObjectsForLeaderboards)
        {
            x.GetComponent<HighlightOutline>()?.Destroy();
        }
    }

    public void OnCustomizeUnHovered()
    {
        foreach (var x in ObjectsForCustomize)
        {
            x.GetComponent<HighlightOutline>()?.Destroy();
        }
    }


    public void OnBackClicked()
    {
        IsBackVisible = false;
        IsEscVisible = true;
        IsMenuVisible = true;
        if (CurrentPanel != null)
        {
            CurrentPanel.IsMenuVisible = false;
            CurrentPanel = null;
        }
        
        CameraPan.ResetCamera();
        
    }

    public void OnPlayClicked()
    {
        foreach (var x in ObjectsForPlay)
        {
            x.GetComponent<HighlightOutline>()?.Destroy();
        }
        GotoMenu(PlayPanel);
        
        CameraPan.PanCamera(CameraPan.CameraPlay);
        IsBackVisible = true;
        IsEscVisible = false;
        IsMenuVisible = false;
        DoorSwiver.isHovered = false;

    }

    public void OnLeaderboardClicked()
    {
        foreach (var x in ObjectsForLeaderboards)
        {
            x.GetComponent<HighlightOutline>()?.Destroy();
        }
        //CameraPan.PanCamera(CameraPan.CameraLeaderboards);

        IsBackVisible = true;
        IsEscVisible = false;
        IsMenuVisible = false;
    }

    public void OnCustomizeClicked()
    {
        foreach (var x in ObjectsForCustomize)
        {
            x.GetComponent<HighlightOutline>()?.Destroy();
        }
        //CameraPan.PanCamera(CameraPan.CameraCustomize);
        IsBackVisible = true;
        IsEscVisible = false;
        IsMenuVisible = false;
    }


    public void GotoMenu(MainMenuPanel panel)
    {
        IsMenuVisible = false;


        panel.IsMenuVisible = true;
        CurrentPanel = panel;

        IsBackVisible = true;
    }



    public void OnOptionsClicked()
    {

    }

    public void OnQuitClicked()
    {
        Game.Disconnect();
    }


}
