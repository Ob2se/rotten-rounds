@using Sandbox;
@using Sandbox.UI;
@inherits MainMenuPanel
@namespace Sandbox

<div class="fullscreen-blur"></div>
<div class="screen-blocker"></div>
<div class="create-menu-container">
    <div class="brush-stroke"></div>
    <div class="menu-options-container">
        <div class="inputs-line-players">
            <text class="inputs-players">Players</text>
            <div class="slider-maxplayer">
                <SliderControl class="player-slider" ShowValueTooltip="@(false)" ShowTextEntry="@(false)" ShowRange="@(false)" Min=@(1) Max="@(8)" Step="@(1)" Value:bind="@MaxPlayersGame"></SliderControl>
                <text class="inputs-maxplayers">@MaxPlayersGame</text>
            </div>
            
        </div>
        
        <div class="inputs-line-invite @(FriendsOnly ? "unclickable" : "")">
            <text class="inputs-text">Invite Only</text>
            <button class="checkbox @(InviteOnly ? "checked" : "")" @onclick="@(OnInviteClicked)"></button>

        </div>
        <div class="inputs-line-friends @(InviteOnly ? "unclickable" : "")">
            <text class="inputs-text">Friends Only</text>
            <button class="checkbox @(FriendsOnly ? "checked" : "")" @onclick="@(OnFriendsClicked)"></button>

        </div>       
        <div class="create-button-wrapper">
            <button class="create-lobby-button" @onclick="@CreateLobby">Create</button>
        </div>
    </div>
</div>
<div class="back-button-container @(IsBackVisible ? "" : "hidden")">
    <button class="back-button" @onclick="@OnBackClicked">Back</button>
</div>

@code
{
    public Panel InputContainer;

    bool IsBackVisible = true;


    public int MaxPlayersGame = 1;

    public bool InviteOnly = false;
    public bool FriendsOnly = false;

    public int PartyCount { get; set; }

    public MainMenuManager mainMenu { get; set; }

    //

    [Property, TextArea] public string MyStringValue { get; set; } = "Hello World!";

    /// <summary>
    /// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
    /// </summary>
    protected override int BuildHash() => System.HashCode.Combine(InviteOnly, FriendsOnly, PartyCount, MaxPlayersGame);

    public void OnMouseOva()
    {
        
    }


    public void OnBackClicked()
    {
        this.Delete();
    }

    public void GetMainMenuComp()
    { 
        mainMenu = Scene.GetAllComponents<MainMenuManager>().First();
    }


    public void OnInviteClicked()
    {
        if (!InviteOnly)
        {
            InviteOnly = true;
            Log.Info("invite only");
            return;
        }
        if (InviteOnly)
        {
            InviteOnly = false;
            Log.Info("no invite only");
            return;
        }
    }

    public void OnFriendsClicked()
    {
        if (!FriendsOnly)
        {
            FriendsOnly = true;
            Log.Info("friemd only");
            return;
        }
        if (FriendsOnly)
        {
            FriendsOnly = false;
            Log.Info("no friend only");
            return;
        }
    }




    public void CreateLobby()
    {
        GetMainMenuComp();

        _ = mainMenu.CreateLobby(new Network.LobbyConfig()
        {
            MaxPlayers = MaxPlayersGame,
            Privacy = FriendsOnly ? Network.LobbyPrivacy.FriendsOnly
            : InviteOnly ? Network.LobbyPrivacy.Private
            : Network.LobbyPrivacy.Public,
            Name = "Rotten Rounds | Waiting to start... "
        });
    }


}
