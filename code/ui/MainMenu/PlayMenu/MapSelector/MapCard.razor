@using Sandbox;
@using Sandbox.UI;
@inherits MainMenuPanel
@namespace Sandbox

<button class="card-container" @onclick="@MapSelected">
    <div class="map-title-wrapper">
        <div class="map-title">@MapName</div>
    </div>
    <div class="bg-image" style="background-image: url('@MapThumbnail');">
        
    </div>
    <div class="bottom-card">
        <text class="author">@MapAuthor</text>
        <div class="map-rating">
            <text class="thumbs-up-icon">thumb_up_alt</text>
            <div class="map-up-votes">@MapRatingUp</div>
            <text class="thumbs-down-icon">thumb_down_alt</text>
            <div class="map-down-votes">@MapRatingDown</div>
        </div>
    </div>
</button>

@code
{


    [Parameter]
    public string MapName { get; set; } 

    [Parameter]
    public string MapAuthor { get; set; }

    [Parameter]
    public string MapRatingUp { get; set; }

    [Parameter]
    public string MapRatingDown { get; set; }

    [Parameter]
    public string MapThumbnail { get; set; }




    [Parameter]
    public MapData MapsData { get; set; }

    private void MapSelected()
    {

    }


	/// <summary>
	/// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
	/// </summary>
	protected override int BuildHash() => System.HashCode.Combine( MapName, MapAuthor, MapRatingUp, MapRatingDown );
}
