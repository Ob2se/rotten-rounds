@using Sandbox;
@using Sandbox.UI;
@inherits MainMenuPanel
@namespace Sandbox

<div class="play-container @(IsMenuVisible ? "" : "hidden")">
    <div class="button-containers">
        <button class="button-join" @onclick="@OnJoinClicked" @onmouseover="@OnJoinHovered" onmouseout="@OnJoinUnhovered"></button>
        <button class="button-create" @onclick="@OnCreateClicked" @onmouseover="@OnCreateHovered" onmouseout="@OnCreateUnhovered"></button>
    </div>
</div>

@code
{

    MainMenuPanelComponent mainMenu { get; set; }

    [Parameter]
    public DecalHighlight CreaterDecal { get; set; }


    [Parameter]
    public DecalHighlight JoinerDecal { get; set; }


    public LightFlickerSolid CreateLight;
    public LightFlickerSolid JoinLight;

    /// <summary>
    /// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
    /// </summary>
    protected override int BuildHash() => System.HashCode.Combine( IsMenuVisible );

    void OnJoinClicked()
    {
        var x = AddChild<ServerBrowser>();
    }



    void OnCreateHovered()
    {
        CreaterDecal.HighlightOn();
        CreateLight.isHovered = true;
        JoinLight.Unselected = true;
    }

    void OnCreateUnhovered()
    {
        CreaterDecal.HighlightOff();
        CreateLight.isHovered = false;
        JoinLight.Unselected = false;
    }

    void OnJoinHovered()
    {
        JoinerDecal.HighlightOn();
        JoinLight.isHovered = true;
        CreateLight.Unselected = true;
    }

    void OnJoinUnhovered()
    {
        JoinerDecal.HighlightOff();
        JoinLight.isHovered = false;
        CreateLight.Unselected = false;
    }


    void OnCreateClicked()
    {
        var x = AddChild<CreateGame>();
        
        
    }


}
