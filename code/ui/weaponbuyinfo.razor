@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root>
    <div class="WeaponName">@WeaponName
        <p class="WeaponCost">@Cost</p>	
    </div>
</root>

@code
{

    [Property, TextArea] public string WeaponName { get; set; } = "";
    public int Cost {get; set;}

    /// <summary>
    /// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
    /// </summary>
    protected override int BuildHash() => System.HashCode.Combine( WeaponName, Cost );


    protected override void OnStart()
    {
        
    }




}
